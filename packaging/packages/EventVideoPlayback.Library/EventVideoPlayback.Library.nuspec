<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Beckhoff-USA-Community.XAE.PLC.Lib.EventVideoPlayback</id>
    <version>1.1.1</version>
    <title>EventVideoPlayback PLC Library</title>
    <authors>Beckhoff Automation LLC</authors>
    <projectUrl>https://github.com/Beckhoff-USA-Community/EventVideoPlayback</projectUrl>
    <copyright>(c) Beckhoff Automation LLC</copyright>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE.md</license>
    <icon>package-icon.png</icon>
    <readme>docs/README.md</readme>
    <summary>PLC library for Event Video Playback system integration</summary>
    <tags>Beckhoff TwinCAT AllowMultipleVersions</tags>
    <releaseNotes>Version 1.1.1 - Compatible with EventVideoPlayback 2.0.0</releaseNotes>
    <description>EventVideoPlayback PLC Library - TwinCAT 3 library for video playback event management.</description>
    <dependencies>
		<dependency id="TwinCAT.Standard.XAE" version="0.0.0" />
		<dependency id="TF7xxx.Vision.XAE" version="0.0.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="bin\**" target="tools" />
	<file src="docs\README.md" target="docs\README.md"/>
    <file src="LICENSE.md" target="LICENSE.md" />
    <file src="package-icon.png" target="package-icon.png" />
  </files>
</package>
