        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Subscribe := SubscribeEvents;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="TimeAfterEvent" Id="{a61fddf6-6152-0777-3afd-46836a8aa557}" FolderPath="Properties\">
