      <Declaration><![CDATA[(* TRUE when the configured time window needs more frames than the buffer can hold. Raises the VideoConfigTooLongForBufferSize alarm. Shorten the window or raise MAX_NUMBER_IMAGES_2_VIDEO. *)
PROPERTY IsTooLongForBufferFPS : BOOL]]></Declaration>
      <Get Name="Get" Id="{ba27a5fe-e721-474b-be9e-46454827fc54}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsTooLongForBufferFPS := Error_VideoConfigTooLongForBufferSize;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="JsonAttribute" Id="{bc5c6c9f-27e5-45e1-a6fc-10942dc86275}" FolderPath="Properties\">
      <Declaration><![CDATA[(* JSON attribute used to filter subscribed events. Initialize always rebuilds this from CameraName, so a value written before the first CyclicLogic call is replaced. Write it after initialization to use a custom filter. *)
PROPERTY JsonAttribute : T_MaxString]]></Declaration>
      <Set Name="Set" Id="{5f19d56c-26af-4e98-bfe1-6db55793388a}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_JSONAttribute := JsonAttribute;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="OnAlarmRaised" Id="{a4216244-1602-09d6-0b03-bc06f4eb6cd4}" FolderPath="ListenerBase2\">
      <Declaration><![CDATA[(* Listener callback. Latches a capture request for the next CyclicLogic scan.
   Called by the event logger when a subscribed alarm is raised. *)
METHOD OnAlarmRaised : HRESULT
VAR_INPUT
	fbEvent : REFERENCE TO FB_TcEvent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// This is where we actually do the work
IF NOT TriggerVideoCapture AND BufferHasRolledOver THEN
	TriggerVideoCapture := TRUE;
	ImageWriteCount		:= 1;

	// Copy the timestamp by value. The capture runs across many later scans and the listener is
	// free to reuse its event object in the meantime, so holding a reference here would let a
	// second event overwrite the stamp and name the video after the wrong alarm.
	EventTimestampUtc := fbEvent.nTimestamp;
ELSE
	MissedEventCount := MissedEventCount + 1;
END_IF

OnAlarmRaised := S_OK;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ReductionFactor" Id="{e7c1975c-171a-423c-b46e-fd49a7ac01d7}" FolderPath="Properties\">
      <Declaration><![CDATA[(* Scale applied to each frame before buffering, which trades video resolution for memory. Values above 1 are limited to 1, and values of 0 or below are replaced with the 0.25 default. 1 keeps full size. *)
PROPERTY ReductionFactor : LREAL]]></Declaration>
      <Set Name="Set" Id="{48310df7-a11a-4c06-b689-997afa81dd7d}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[// Clamp to a usable scale. Zero or negative produces a zero size resize, and above 1
// enlarges every frame, which defeats the point of the reduction.
IF ReductionFactor <= 0 THEN
	_ReductionFactor := 0.25;
ELSIF ReductionFactor > 1 THEN
	_ReductionFactor := 1;
ELSE
	_ReductionFactor := ReductionFactor;
END_IF]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Reset" Id="{de2b7674-77b7-46bd-a0ea-4c6052e3c6d4}" FolderPath="Method\">
      <Declaration><![CDATA[(* Clears the configuration alarms and the latched error state.
   Use after correcting a configuration or after the video service has been restored. Does not
   interrupt a capture that is already running. *)
METHOD Reset
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF VideoCaptureAlarm[E_VideoAlarm.RouterMemoryTooSmall].bRaised THEN
	VideoCaptureAlarm[E_VideoAlarm.RouterMemoryTooSmall].Clear(0,0);	
END_IF
IF VideoCaptureAlarm[E_VideoAlarm.VideoConfigTooLongForBufferSize].bRaised THEN
	VideoCaptureAlarm[E_VideoAlarm.VideoConfigTooLongForBufferSize].Clear(0,0);	
END_IF
_Error := FALSE;
_ErrorID := 0;
_Reset := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Property Name="SubscribedEvents" Id="{fa27ebeb-13ea-0182-05e6-7047decd22f3}" FolderPath="ListenerBase2\">
      <Declaration><![CDATA[(* TRUE while the block is subscribed to the event logger. *)
PROPERTY SubscribedEvents : BOOL]]></Declaration>
      <Get Name="Get" Id="{ece6223f-0ef0-0646-29e9-970c8168bc95}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SubscribedEvents := _Subscribed;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SubscribeEvents" Id="{71454155-952e-0eb2-314d-87c5203208ce}" FolderPath="ListenerBase2\">
      <Declaration><![CDATA[(* Set TRUE to subscribe to matching events. The subscription is made on the next CyclicLogic call. *)
PROPERTY SubscribeEvents : BOOL]]></Declaration>
