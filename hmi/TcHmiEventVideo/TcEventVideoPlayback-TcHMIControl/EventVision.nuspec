<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>EventVision</id>
    <version>1.2.1</version>
    <description>TwinCAT HMI extension to support playback of event based videos generated from the EventVideoPlayback system service.</description>
    <authors>Beckhoff Automation LLC</authors>
    <title>EventVision</title>
    <owners>Beckhoff Automation LLC</owners>
    <projectUrl>https://github.com/Beckhoff-USA-Community/EventVideoPlayback</projectUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <releaseNotes>Details popup rebuilt for current TE2000 framework packages with a stock popup fallback, video button texts localized (en, de), grid template and themes now inherit from the stock event grid. Minimum framework versions are listed in the dependencies.</releaseNotes>
    <copyright>Copyright 2026</copyright>
    <tags>TwinCAT HMI</tags>
    <license type="file">LICENSE.txt</license>
    <icon>images/EventVideoPlayback_512x512.png</icon>
    <dependencies>
      <group targetFramework="native1.12-tchmi">
        <dependency id="Beckhoff.TwinCAT.HMI.Framework" version="14.5.1" />
        <dependency id="Beckhoff.TwinCAT.HMI.Controls" version="14.7.1" />
        <dependency id="Beckhoff.TwinCAT.HMI.EventLogger" version="23.0.275" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="LICENSE.txt" target="" />
    <file src="**\*" target="runtimes\native1.12-tchmi\" exclude=".eslintrc.json;**\*.nuspec;**\*.tpl.json;**\*.hmi*proj;**\~*;**\*.tmp;**\tmp*;**\*.user;**\tsconfig.json;**\*.log;**\*.bak;**\obj\**\*;packages.config;packages.xsd;.hmiframework\**\*;.hmipkgs\**\*;.git;.gitignore;.gitattributes;Server\**\*;Properties\**\*;Fonts\**\*;bin\**\*" />
    <file src="images\EventVideoPlayback_512x512.png" target="images\" />
  </files>
</package>