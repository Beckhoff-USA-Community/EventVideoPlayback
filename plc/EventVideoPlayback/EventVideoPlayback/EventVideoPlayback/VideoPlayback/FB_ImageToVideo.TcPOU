    <Method Name="TriggerAlarmForVideoCapture" Id="{2355e316-b6d2-49ed-9430-7db9c90ea34b}" FolderPath="Method\">
      <Declaration><![CDATA[(* Raises the camera alarm from PLC code, which starts a video capture.
   Use this when the condition worth recording is detected in the PLC rather than by another
   event source. LogEntryName is shown in the alarm text and identifies what happened.
   Ignored while the alarm is already raised, or before the ring buffer has filled once. *)
METHOD PUBLIC TriggerAlarmForVideoCapture
VAR_INPUT
	LogEntryName : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT VideoCaptureAlarm[E_VideoAlarm.Camera1Alarm].bRaised AND BufferHasRolledOver THEN
	VideoCaptureAlarm[E_VideoAlarm.Camera1Alarm].ipArguments.Clear().AddString(LogEntryName).AddString(_CameraName);
	VideoCaptureAlarm[E_VideoAlarm.Camera1Alarm].Raise(0);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="UnsubscribeEvents" Id="{752ce0f7-bc09-0370-158c-993e9a9082a9}" FolderPath="ListenerBase2\">
      <Declaration><![CDATA[(* Set TRUE to unsubscribe from events. The unsubscribe happens on the next CyclicLogic call. *)
PROPERTY UnsubscribeEvents : BOOL]]></Declaration>
      <Set Name="Set" Id="{6e6813a4-c831-0192-1157-e8b7eb471407}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Unsubscribe := UnsubscribeEvents;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="VideoOutputDirectory" Id="{338cb32a-2e12-02b7-2a0b-cfa934436f1b}" FolderPath="Properties\">
      <Declaration><![CDATA[(* Root directory for images and videos, which the Windows service must also be able to reach. Videos are written to <directory>\<CameraName>\. Read each time a capture builds its paths, so a change takes effect on the next capture. Defaults to C:\TcAlarmVideo. *)
PROPERTY VideoOutputDirectory : STRING]]></Declaration>
      <Set Name="Set" Id="{5d78897d-a29a-0c23-3af8-a7a2fcb5135e}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_VideoOutputDirectory := VideoOutputDirectory;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="WriteImage" Id="{196768c3-fed0-05e7-0363-23a08fbc093e}" FolderPath="Method\">
      <Declaration><![CDATA[(* Writes one buffered frame to disk as a PNG. Called repeatedly by the capture state machine.
   Index is the frame number used in the file name (Image0001.png and upward), and
   BufferImageSaveNameIndex is the ring position to read. Returns TRUE when the frame has been
   written. FALSE means either that the write is still in progress or that it failed; the caller
   tells them apart through the internal failure flag and bounds the number of attempts. *)
METHOD WriteImage : BOOL
VAR_INPUT
	BufferImageSaveNameIndex : UINT;
	Index					 : UINT;
END_VAR

VAR
	SysTimeAtImageSave : ULINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE WriteFileState OF
	0:
		sImageToSaveName := CONCAT(STR1 := _VideoOutputDirectory, '\');
		sImageToSaveName := CONCAT(STR1 := sImageToSaveName, _CameraName);
		sImageToSaveName := CONCAT(STR1 := sImageToSaveName, '\Images\Image');
		CASE Index OF // Add leading zeros to index number of image name
			0..9:
				sImageToSaveName := CONCAT(sImageToSaveName, '000');
				sImageToSaveName := CONCAT(sImageToSaveName, TO_STRING(Index));

			10..99:
				sImageToSaveName := CONCAT(sImageToSaveName, '00');
				sImageToSaveName := CONCAT(sImageToSaveName, TO_STRING(Index));

			100..999:
				sImageToSaveName := CONCAT(sImageToSaveName, '0');
				sImageToSaveName := CONCAT(sImageToSaveName, TO_STRING(Index));

		ELSE
			sImageToSaveName := CONCAT(sImageToSaveName, TO_STRING(Index));
		END_CASE;

		sImageToSaveName := CONCAT(sImageToSaveName, '.png');
		ipImageToSave	 := BufferImageRing[BufferImageSaveNameIndex];

		// Starting a fresh attempt. Clearing here is what makes the caller's failure counter
		// count attempts: the flag stays set only for the single scan that reports a failure.
		Error_FailedToWriteImagesToDisk := FALSE;

		// Copy write image here
		fbWriteImage(ipImage   := ipImageToSave,
					 sFilePath := sImageToSaveName,
					 nTimeout  := T#500MS,
					 bWrite	   := TRUE);

		WriteFileState := 10;

	10:
		// sFilePath must contain the full path, image name and type
		fbWriteImage(sFilePath := '', bWrite := FALSE); // This updates the Busy
		IF NOT fbWriteImage.bBusy AND NOT fbWriteImage.bError THEN
			fbWriteImage(sFilePath := sImageToSaveName, bWrite := FALSE);
			WriteFileState		:= 0;
			Error_FailedToWriteImagesToDisk := FALSE;
			WriteImage			:= TRUE;
		ELSIF fbWriteImage.bError THEN
			fbWriteImage(sFilePath := sImageToSaveName, bWrite := FALSE);

			// Failure to write to disk
			Error_FailedToWriteImagesToDisk := TRUE;
			WriteFileState		:= 0;
		END_IF

ELSE
	WriteFileState := 0;
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>