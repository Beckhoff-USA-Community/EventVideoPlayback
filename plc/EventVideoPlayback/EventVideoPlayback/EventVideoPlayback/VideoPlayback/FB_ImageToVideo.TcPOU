      <Declaration><![CDATA[(* How much footage to keep before the alarm. Added to TimeAfterEvent to size the buffer. Defaults to 7 seconds. *)
PROPERTY TimeBeforeEvent : TIME]]></Declaration>
      <Set Name="Set" Id="{dc460ac9-796d-4731-a912-ff44c2867fa5}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_TimeBeforeEvent := TimeBeforeEvent;]]></ST>
