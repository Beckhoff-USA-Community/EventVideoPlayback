# ============================================================================
# EventVideoPlayback .gitignore
# ============================================================================

# ===== Development Notes =====
Instructions.txt

# ===== Visual Studio =====
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.sln.iml
.idea/

# ===== Rider =====
.idea/
*.sln.iml

# ===== Build Results =====
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
# Exception: Track packaging/release directory contents (override [Rr]elease/ exclusion)
!packaging/release/
[Rr]eleases/
x64/
x86/
[Ww]in32/
[Aa]rm/
[Aa]rm64/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
bld/

# ===== .NET =====
project.lock.json
project.fragment.lock.json
artifacts/

# ===== NuGet =====
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config
# Exception: Track packaging/packages (TwinCAT packages, not NuGet)
!packaging/packages/
!packaging/packages/**
*.nuget.props
*.nuget.targets
.nuget/

# ===== TwinCAT Specific =====
_Boot/
# Vendored library cache. TwinCAT restores these from the library repository on open, and the
# placeholder resolutions float to the newest installed version, so committing them only pins
# stale copies and duplicates versions.
_Libraries/
_Repository/
*.tpy
*.tmc
# Editor session artifact XAE leaves next to the solution
*.~u
# Exception: the hand written event class, a source file the PLC project cannot build without
!plc/EventVideoPlayback/EventVideoPlayback/VideoAlarm.tmc
# Exception: the PLC project's imported copy of that event class. XAE drops the project
# reference when this file is absent, and the saved library then omits the event class.
!plc/EventVideoPlayback/EventVideoPlayback/EventVideoPlayback/ExternalTypes.tmc
*.compiled-library
*.compileinfo

# ===== TwinCAT HMI =====
.engineering_servers/
**/Packages/
!**/packages.config
# Live HMI server state, rewritten by Engineering every session, can capture local TLS keys
hmi/TcHmiEventVideo/TcEventVideoPlayback-TcHMIControl/Server/

# ===== Windows Service =====
**/publish/

# ===== Native Libraries (restored via NuGet) =====
*.dll
*.so
*.dylib
# Exception: Source codec library
!src/CodecLibs/openh264-1.8.0-win64.dll
# Exception: TwinCAT package libraries (outside of bin folders)
!packaging/packages/**/*.dll

# ===== Executables =====
*.exe
# Exception: Allow scripts
!packaging/scripts/*.exe
!packaging/**/*.bat

# ===== TwinCAT Package Build System =====
packaging/release/*.nupkg
packaging/release/*.txt
packaging/release/*.md

# Exception: Track packaging/packages directory (override global [Bb]in/ exclusion)
!packaging/packages/

# Exclude bin folder contents in packages (but not the folder itself). The
# documentation payload staged into its bin before packing stays untracked.
packaging/packages/*/bin/*
# Exception: committed package payloads that hosted runners cannot build. The PLC
# library comes from an XAE save as library, the HMI control package from a TwinCAT
# HMI Engineering build. CI guards their presence and their versions at tag time.
!packaging/packages/EventVideoPlayback.Library/bin/EventVideoPlayback.library
!packaging/packages/EventVision.HMI/bin/EventVision.*.nupkg

# Exclude tools folder contents in packages
packaging/packages/*/tools/*
!packaging/packages/*/tools/*.ps1
!packaging/packages/*/tools/chocolateyinstall.ps1
!packaging/packages/*/tools/chocolateyuninstall.ps1

# ===== Test Results =====
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# ===== OS Generated =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== Backup Files =====
*.bak
*.backup
*~

# ===== Docs build output =====
/site/
