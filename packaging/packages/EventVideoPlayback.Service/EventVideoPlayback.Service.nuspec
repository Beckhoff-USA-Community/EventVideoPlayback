<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Beckhoff-USA-Community.XAR.Service.EventVideoPlayback</id>
    <version>2.1.0</version>
    <title>EventVideoPlayback System Service</title>
    <authors>Beckhoff Automation LLC</authors>
    <projectUrl>https://github.com/Beckhoff-USA-Community/EventVideoPlayback</projectUrl>
    <copyright>(c) Beckhoff Automation LLC</copyright>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE.md</license>
    <icon>package-icon.png</icon>
    <readme>docs/README.md</readme>
    <summary>EventVideoPlayback runtime system service for TwinCAT XAR</summary>
    <tags>Beckhoff Setup SystemServiceRestart</tags>
    <releaseNotes>https://beckhoff-usa-community.github.io/EventVideoPlayback/changelog/</releaseNotes>
    <description>EventVideoPlayback System Service - Windows service for video playback event management on TwinCAT runtime systems.</description>
    <dependencies>
		<dependency id="TwinCAT.XAR.AdsApi" version="0.0.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="bin\**" target="tools\bin" />
    <file src="LICENSE.md" target="LICENSE.md" />
	<file src="docs\README.md" target="docs\README.md"/>
    <file src="package-icon.png" target="package-icon.png" />
  </files>
</package>
